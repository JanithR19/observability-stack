otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
    logs    = [otelcol.exporter.loki.default.input]
  }
}

// 1. Export Metrics to Prometheus
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = sys.env("PROMETHEUS_ENDPOINT")
  }
}

// 2. Export Traces to Tempo
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = sys.env("TEMPO_ENDPOINT")
    tls {
      insecure = true
    }
  }
}

// 3. Export Logs to Loki
otelcol.exporter.loki "default" {
  forward_to = [loki.relabel.default.receiver]
}

// Aggressive relabeling to catch service.name from OTel
loki.relabel "default" {
  forward_to = [loki.write.default.receiver]

  // Rule 1: Catch service.name
  rule {
    action       = "replace"
    source_labels = ["__meta_otel_resource_service_name"]
    target_label  = "service"
  }

  // Rule 2: Fallback for service.name
  rule {
    action       = "replace"
    source_labels = ["service_name"]
    target_label  = "service"
  }

  // Rule 3: Set a static job label so Loki always has at least one index
  rule {
    action       = "replace"
    target_label = "job"
    replacement  = "otel-logs"
  }
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_ENDPOINT")
  }
}
