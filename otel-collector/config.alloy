otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    traces  = [otelcol.exporter.otlphttp.tempo.input]
    logs    = [otelcol.exporter.loki.default.input]
  }
}

// 1. Export Metrics to Prometheus
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = sys.env("PROMETHEUS_ENDPOINT")
  }
}

// 2. Export Traces to Tempo
otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = sys.env("TEMPO_ENDPOINT")
    tls {
      insecure = true
    }
  }
}

// 3. Export Logs to Loki
otelcol.exporter.loki "default" {
  forward_to = [loki.process.json.receiver]
}

// Parse JSON body to extract service name if present
loki.process "json" {
  forward_to = [loki.relabel.default.receiver]

  stage.json {
    expressions = {
      extracted_service = "resources.\"service.name\"",
    }
  }

  stage.labels {
    values = {
      service_name = "extracted_service",
    }
  }
}

loki.relabel "default" {
  forward_to = [loki.write.default.receiver]

  // Now that we have the correct service_name (either from OTel defaults or extracted from JSON),
  // we copy it to 'service' and 'job' so you can use any of those labels in Grafana.
  rule {
    action       = "replace"
    source_labels = ["service_name"]
    target_label  = "service"
  }

  rule {
    action       = "replace"
    source_labels = ["service_name"]
    target_label  = "job"
  }
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_ENDPOINT")
  }
}
