otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    traces  = [otelcol.exporter.otlphttp.tempo.input]
    logs    = [otelcol.processor.resource.default.input]
  }
}

// Ensure resource attributes like service.name are processed correctly
otelcol.processor.resource "default" {
  output {
    logs = [otelcol.exporter.loki.default.input]
  }
}

// 1. Export Metrics to Prometheus
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = sys.env("PROMETHEUS_ENDPOINT")
  }
}

// 2. Export Traces to Tempo
otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = sys.env("TEMPO_ENDPOINT")
    tls {
      insecure = true
    }
  }
}

// 3. Export Logs to Loki
otelcol.exporter.loki "default" {
  forward_to = [loki.relabel.default.receiver]
}

loki.relabel "default" {
  forward_to = [loki.write.default.receiver]

  // 1. Try to get the name from the OTel Resource Attribute
  rule {
    action       = "replace"
    source_labels = ["__meta_otel_resource_service_name"]
    target_label  = "service"
  }

  // 2. Fallback: If the OTel exporter already produced a 'service_name' label
  rule {
    action       = "replace"
    source_labels = ["service_name"]
    target_label  = "service"
  }

  // 3. Ensure 'job' matches 'service' for consistency
  rule {
    action       = "replace"
    source_labels = ["service"]
    target_label  = "job"
  }
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_ENDPOINT")
  }
}
